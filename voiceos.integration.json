.shapes button.cloud{clip-path:polygon(97.8% 50.0%,100.1% 55.8%,100.7% 62.0%,99.8% 68.1%,97.3% 73.8%,93.3% 78.6%,88.3% 82.2%,82.5% 84.4%,76.3% 85.0%,70.2% 84.1%,65.1% 87.4%,59.6% 90.2%,53.6% 91.8%,47.4% 91.9%,41.3% 90.6%,35.7% 87.9%,30.5% 84.6%,24.4% 85.8%,18.2% 85.4%,12.3% 83.5%,7.1% 80.1%,2.9% 75.6%,-0.0% 70.1%,-1.5% 64.0%,-1.4% 57.8%,0.3% 51.9%,3.4% 46.5%,7.8% 42.1%,12.4% 38.3%,12.8% 32.1%,14.6% 26.2%,17.6% 20.8%,21.9% 16.2%,27.0% 12.8%,32.8% 10.6%,39.0% 9.7%,45.2% 10.3%,51.1% 12.3%,56.3% 15.6%,62.1% 15.4%,68.3% 15.1%,74.4% 16.3%,79.9% 19.1%,84.5% 23.2%,87.9% 28.4%,89.9% 34.3%,90.2% 40.5%,94.2% 45.0%)}.av.teardrop,.shapes button.teardrop{clip-path:polygon(54.9% 6.2%,50.5% 3.2%,45.7% 5.5%,42.2% 9.8%,38.7% 14.1%,35.3% 18.3%,31.8% 22.6%,28.3% 26.9%,24.9% 31.2%,21.4% 35.5%,18.0% 39.9%,15.3% 44.7%,13.3% 49.8%,12.0% 55.2%,11.5% 60.7%,11.8% 66.2%,12.9% 71.6%,14.7% 76.8%,17.3% 81.7%,20.5% 86.1%,24.3% 90.1%,28.7% 93.5%,33.5% 96.2%,38.6% 98.2%,44.0% 99.4%,49.5% 99.9%,55.0% 99.6%,60.4% 98.5%,65.6% 96.6%,70.5% 94.0%,74.9% 90.7%,78.9% 86.9%,82.2% 82.5%,84.9% 77.7%,86.9% 72.5%,88.1% 67.2%,88.5% 61.7%,88.2% 56.2%,87.0% 50.8%,85.1% 45.6%,82.5% 40.7%,79.2% 36.3%,75.8% 32.0%,72.3% 27.7%,68.8% 23.4%,65.4% 19.1%,61.9% 14.8%,58.4% 10.5%)}.av.wedge .eyes{top:18%}.av.teardrop .eyes{top:14%}\n.av{transform-origin:50% 60%}\n.av .eyes{position:absolute;inset:0;will-change:transform}\n.av .eye{position:absolute;top:31%;width:11%;height:27%;background:var(--eye);border-radius:99px;transform:rotate(12deg);transition:transform .13s ease,height .28s cubic-bezier(.3,.9,.3,1),top .28s,width .28s,border-radius .28s}\n.av .eye.l{left:38%}.av .eye.r{left:56%}\n.av.blink .eye{transform:rotate(12deg) scaleY(.1)}\n.av[data-state=working]{animation:bob 1.1s ease-in-out infinite}.av[data-state=working] .eye{height:21%;top:34%}\n.av[data-state=thinking]{animation:tilt 3.2s ease-in-out infinite}.av[data-state=thinking] .eye.r{height:17%;top:37%}\n.av[data-state=waiting]{animation:rock 2.6s ease-in-out infinite}.av[data-state=waiting] .eye{height:32%;top:28%;width:13%}\n.av[data-state=blocked]{animation:shake 3.2s ease-in-out infinite}.av[data-state=blocked] .eye{height:8%;top:41%;transform:rotate(0)}\n.av[data-state=done]{animation:hop .7s cubic-bezier(.3,1.4,.4,1) both}.av[data-state=done] .eye{height:13%;width:15%;top:36%;border-radius:99px 99px 12px 12px;transform:rotate(0)}\n.av.ack{animation:squash .38s cubic-bezier(.3,1.5,.5,1)}\n@keyframes bob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-4%) rotate(-3deg)}}\n@keyframes tilt{0%,100%{transform:rotate(-5deg)}50%{transform:rotate(-8deg) translateY(-2%)}}\n@keyframes rock{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}\n@keyframes shake{0%,10%,100%{transform:translateX(0)}2%{transform:translateX(-6%)}4%{transform:translateX(6%)}6%{transform:translateX(-4%)}8%{transform:translateX(3%)}}\n@keyframes hop{0%{transform:translateY(0)}40%{transform:translateY(-18%) scale(1.06,.94)}70%{transform:translateY(0) scale(.97,1.04)}100%{transform:none}}\n@keyframes squash{0%{transform:scale(1)}40%{transform:scale(1.14,.86)}100%{transform:scale(1)}}\n.dot.warn{background:var(--accent)}.dot.bad{background:var(--bad)}\n.av.small{width:24px;height:24px}.av.tiny{width:18px;height:18px}\n.chip{display:inline-flex;align-items:center;font-size:11px;font-weight:500;color:var(--ink-2);background:var(--fill-2);border-radius:6px;padding:1px 6px;line-height:16px;white-space:nowrap}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--ink-3);flex:none}\n.dot.on{background:var(--good);box-shadow:0 0 0 0 rgba(52,201,110,.6);animation:pulse 1.8s ease-out infinite}\n@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(52,201,110,.55)}100%{box-shadow:0 0 0 6px rgba(52,201,110,0)}}\n.lbl{font-size:11px;font-weight:600;color:var(--ink-2);letter-spacing:.02em;text-transform:uppercase;margin:0 0 5px 2px}\n.confirm-pad{height:48px}\n.foot{display:flex;align-items:center;gap:6px;padding:0 15px;height:56px;color:var(--ink-3);font-size:11.5px;padding-right:160px}\n.bubble{max-width:82%;padding:8px 12px;border-radius:16px;font-size:13.5px;line-height:1.38;word-wrap:break-word}\n.bubble.bot{background:var(--fill-2);border-bottom-left-radius:6px;align-self:flex-start}\n.bubble.me{background:var(--fill-3);border-bottom-right-radius:6px;align-self:flex-end}\n.bubble b{font-weight:650}\n.sys{align-self:center;color:var(--ink-3);font-size:11.5px;display:flex;align-items:center;gap:5px;padding:2px 0}\n.msgs{display:flex;flex-direction:column;gap:6px;padding:4px 14px 8px;overflow-y:auto}\n.compose{display:flex;align-items:center;gap:8px;margin:4px 12px 12px;background:var(--fill-1);border:1px solid var(--line);border-radius:22px;padding:5px 5px 5px 6px}\n.compose input{background:none;border:0;padding:6px 4px;flex:1;min-width:0}\n.compose .plus{width:30px;height:30px;border-radius:50%;background:var(--fill-2);color:var(--ink-2);font-size:18px;line-height:30px;text-align:center;flex:none}\n.compose .send{width:30px;height:30px;border-radius:50%;background:var(--ink-1);color:#000;flex:none;display:grid;place-items:center;transition:transform .12s,opacity .15s}\n.compose .send:active{transform:scale(.92)}\n.compose .send[disabled]{opacity:.35}\n.row{display:flex;align-items:center;gap:11px;padding:8px 15px;transition:background .12s;width:100%;text-align:left;border-radius:14px}\n.row:hover{background:var(--fill-1)}\n.row:active{background:var(--fill-2)}\n\n.fade-in{animation:in .28s cubic-bezier(.2,.8,.2,1) both}\n@keyframes in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n\n<style>.preview{display:flex;align-items:center;gap:14px;padding:4px 15px 10px}.preview .av{width:56px;height:56px;transition:background .2s,border-radius .2s,clip-path .2s}.sw{display:flex;gap:7px;flex-wrap:wrap}.sw button{width:22px;height:22px;border-radius:50%;background:var(--c);outline:2px solid transparent;outline-offset:2px;transition:outline-color .15s,transform .12s}.sw button:hover{transform:scale(1.08)}.sw button[aria-pressed=true]{outline-color:var(--ink-1)}.shapes{display:flex;gap:6px;margin-top:8px}.shapes button{width:22px;height:22px;background:var(--fill-3);outline:2px solid transparent;outline-offset:2px}.shapes button[aria-pressed=true]{background:var(--ink-1)}.f{padding:0 15px 9px}.two{display:grid;grid-template-columns:1.2fr 1fr;gap:9px}.tg{display:flex;align-items:center;gap:10px;margin:0 15px;padding:9px 12px;background:var(--fill-1);border:1px solid var(--line);border-radius:14px}.sw2{width:40px;height:24px;border-radius:12px;background:var(--fill-3);position:relative;transition:background .2s;flex:none}.sw2::after{content:\"\";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.4);transition:transform .2s}.sw2[aria-checked=true]{background:var(--good)}.sw2[aria-checked=true]::after{transform:translateX(16px)}</style>\n<div class=\"hd\"><span class=\"mark\"><img class=\"voiceos-mk\" style=\"width:16px;height:16px;border-radius:5px;object-fit:contain;display:inline-block;vertical-align:middle\" src=\"data:image/png;base64,\" alt=\"Grok Bot\">Grok Bot</span><span class=\"grow\"></span><span class=\"t3\">New Bot</span></div>\n<div class=\"preview\"><span class=\"av blob\" id=\"pv\" data-state=\"idle\" style=\"--c:#FF6700\"><span class=\"eyes\"><i class=\"eye l\"></i><i class=\"eye r\"></i></span></span><div class=\"grow\"><div class=\"sw\" id=\"sw\" data-voiceos-key=\"color\" data-value=\"orange\"></div><div class=\"shapes\" id=\"shapes\" data-voiceos-key=\"shape\" data-value=\"blob\"><button class=\"blob\" data-v=\"blob\" aria-pressed=\"true\" aria-label=\"Blob\"></button><button class=\"pebble\" data-v=\"pebble\" aria-label=\"Pebble\"></button><button class=\"squircle\" data-v=\"squircle\" aria-label=\"Squircle\"></button><button class=\"tablet\" data-v=\"tablet\" aria-label=\"Tablet\"></button><button class=\"wedge\" data-v=\"wedge\" aria-label=\"Wedge\"></button><button class=\"hex\" data-v=\"hex\" aria-label=\"Hex\"></button><button class=\"cloud\" data-v=\"cloud\" aria-label=\"Cloud\"></button><button class=\"teardrop\" data-v=\"teardrop\" aria-label=\"Teardrop\"></button></div></div></div>\n<div class=\"f two\"><div><div class=\"lbl\">Name</div><input data-voiceos-key=\"name\" id=\"name\" placeholder=\"New Bot\" maxlength=\"40\"></div><div><div class=\"lbl\">Label <span style=\"text-transform:none;font-weight:500;opacity:.7\">optional</span></div><input data-voiceos-key=\"label\" placeholder=\"Research, admin\"></div></div>\n<div class=\"f\"><div class=\"lbl\">Description</div><textarea data-voiceos-key=\"description\" rows=\"2\" placeholder=\"What this Bot is for\"></textarea></div>\n<div class=\"tg\"><div class=\"grow\"><div class=\"t2\">Notifications</div><div class=\"t3\" style=\"white-space:normal\">Get notified when this Bot finishes or needs input</div></div><button class=\"sw2\" role=\"switch\" aria-checked=\"true\" data-voiceos-key=\"notifications\" data-value=\"true\" id=\"tg\"></button></div>\n<div class=\"foot\">Created in your Grok Bot workspace</div>\n\n<script>\nconst DEMO={\"data\":{},\"args\":{}};\n\nconst $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst EYES='<span class=\"eyes\"><i class=\"eye l\"></i><i class=\"eye r\"></i></span>';\nconst av=(b,cls='')=>'<span class=\"av '+(b.shape||'blob')+' '+cls+'\" data-state=\"'+esc(b.status||'idle')+'\" style=\"--c:'+esc(b.color)+'\">'+EYES+'</span>';\nlet inited=false;\naddEventListener('message',e=>{const m=e.data;if(!m||m.type!=='voiceos:init')return;inited=true;boot(m.data||DEMO.data,m.args||DEMO.args,(m.theme&&m.theme.mode)||'dark');});\nsetTimeout(()=>{if(!inited)boot(DEMO.data,DEMO.args,'dark')},350);\nfunction boot(data,args,mode){document.documentElement.dataset.theme=mode;render(data||{},args||{});hydrate(args||{});report();new ResizeObserver(report).observe(document.body);}\nfunction getVal(el){return 'value' in el&&el.tagName!=='BUTTON'?el.value:(el.dataset.value??'')}\nfunction setVal(el,v){if('value' in el&&el.tagName!=='BUTTON')el.value=v??'';else{el.dataset.value=v;el.dispatchEvent(new CustomEvent('hydrate',{detail:v}))}}\nfunction hydrate(args){$$('[data-voiceos-key]').forEach(el=>{const k=el.dataset.voiceosKey;if(k in args)setVal(el,args[k]);el.addEventListener('input',()=>stage(k,getVal(el)))})}\nfunction stage(key,value){parent.postMessage({type:'voiceos:updateInput',key,value},'*')}\nfunction report(){if(document.hidden||!document.documentElement.offsetWidth)return;const h=Math.ceil(document.body.getBoundingClientRect().height);if(h>=8)parent.postMessage({type:'voiceos:resize',height:h},'*')}\n\n/* Motion — an original avatar liveness engine: wandering gaze, blinks, cursor-follow, per-state behavior. */\nconst Motion=(()=>{\n const R=(a,b)=>a+Math.random()*(b-a);\n const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;\n let pointer=null,ptrAt=0;\n addEventListener('pointermove',e=>{pointer={x:e.clientX,y:e.clientY};ptrAt=performance.now()});\n document.documentElement.addEventListener('pointerleave',()=>pointer=null);\n const live=new Set();\n const st=m=>m.el.dataset.state||'idle';\n function later(m,fn,ms){const t=setTimeout(()=>{m.timers.delete(t);fn()},ms);m.timers.add(t)}\n function clear(m){m.timers.forEach(clearTimeout);m.timers.clear()}\n function gaze(m,x,y,dur){if(pointer)return;m.eyes.style.transition='transform '+dur+'ms cubic-bezier(.3,.7,.2,1)';m.eyes.style.transform='translate('+x+'%,'+y+'%)'}\n function blink(m,dbl){if(reduce)return;m.el.classList.add('blink');later(m,()=>{m.el.classList.remove('blink');if(dbl)later(m,()=>blink(m),170)},120)}\n function schedule(m){clear(m);const s=st(m);\n  const bl=()=>{blink(m,Math.random()<.2);later(m,bl,R(s==='working'?1600:2600,s==='working'?3200:5800))};later(m,bl,R(300,2400));\n  const gz=()=>{\n   if(s==='idle'){gaze(m,R(-14,14),R(-8,8),R(500,900));later(m,()=>gaze(m,0,0,800),R(900,2400))}\n   else if(s==='working'){gaze(m,R(-16,-8),R(4,10),130);later(m,()=>gaze(m,R(8,16),R(4,10),130),R(220,420))}\n   else if(s==='thinking'){gaze(m,Math.random()<.75?14:-14,-12,600)}\n   else if(s==='waiting'){gaze(m,0,-3,500)}\n   else if(s==='blocked'){gaze(m,0,12,500)}\n   else gaze(m,0,0,300);\n   later(m,gz,s==='working'?R(600,1200):s==='idle'?R(2400,6000):R(1600,3200))};\n  gz();\n  if(s==='done')later(m,()=>set(m.el,'idle'),2200);\n }\n function mount(el){if(el._m||!el.querySelector('.eyes'))return;const m=el._m={el,eyes:el.querySelector('.eyes'),timers:new Set()};live.add(m);schedule(m)}\n function scan(){document.querySelectorAll('.av').forEach(mount);live.forEach(m=>{if(!m.el.isConnected){clear(m);live.delete(m);delete m.el._m}})}\n function tick(){if(pointer&&!reduce){if(performance.now()-ptrAt>4000)pointer=null;else live.forEach(m=>{if(!m.el.isConnected)return;const r=m.el.getBoundingClientRect();const dx=pointer.x-(r.left+r.width/2),dy=pointer.y-(r.top+r.height/2);const d=Math.hypot(dx,dy)||1,k=Math.min(1,d/140);m.eyes.style.transition='transform 200ms cubic-bezier(.2,.8,.2,1)';m.eyes.style.transform='translate('+(dx/d*16*k).toFixed(1)+'%,'+(dy/d*10*k).toFixed(1)+'%)'})}requestAnimationFrame(tick)}\n requestAnimationFrame(tick);\n new MutationObserver(scan).observe(document.documentElement,{childList:true,subtree:true});\n function set(el,s){if(!el)return;el.dataset.state=s;if(el._m)schedule(el._m)}\n function react(el){if(!el)return;el.classList.remove('ack');void el.offsetWidth;el.classList.add('ack');if(el._m)blink(el._m)}\n return{scan,set,react};\n})();\n\nfunction autosize(t){t.style.height='auto';t.style.height=t.scrollHeight+'px'}\n\n\n/* Grok Bot's own avatar palette (name → its exact hex). The card sends the NAME\n   (that is what Grok's createAgent validates); the hex is only for the preview. */\nconst COLORS={orange:'#FF6700',yellow:'#FF9800',red:'#FF263C',magenta:'#FF309B',violet:'#9159FE',blue:'#1084FE',cyan:'#00BCA6',green:'#00C972',brown:'#936439',gray:'#777777'};\nfunction render(d,a){const sw=$('#sw');sw.innerHTML=Object.entries(COLORS).map(([id,c])=>'<button style=\"--c:'+c+'\" data-v=\"'+id+'\" aria-label=\"'+id+'\"></button>').join('');\n const pick=(root,v)=>{root.dataset.value=v;$$('button',root).forEach(b=>b.setAttribute('aria-pressed',b.dataset.v===v));paint();root.dispatchEvent(new Event('input'))};\n const paint=()=>{const pv=$('#pv');pv.style.setProperty('--c',COLORS[sw.dataset.value]||COLORS.orange);pv.className='av '+$('#shapes').dataset.value;Motion.react(pv)};\n [sw,$('#shapes')].forEach(root=>{root.onclick=e=>{const b=e.target.closest('button');if(b)pick(root,b.dataset.v)};root.addEventListener('hydrate',e=>pick(root,e.detail))});\n const tg=$('#tg');tg.onclick=()=>{const on=tg.getAttribute('aria-checked')!=='true';tg.setAttribute('aria-checked',on);tg.dataset.value=String(on);tg.dispatchEvent(new Event('input'))};tg.addEventListener('hydrate',e=>{const on=String(e.detail)==='true';tg.setAttribute('aria-checked',on);tg.dataset.value=String(on)});\n pick(sw,sw.dataset.value);pick($('#shapes'),$('#shapes').dataset.value);\n $('#name').addEventListener('input',()=>Motion.react($('#pv')));const tgl=$('#tg');tgl.addEventListener('input',()=>Motion.set($('#pv'),tgl.dataset.value==='true'?'done':'idle'));\n}\n\n</script>\n",
